{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "moduleResolution": "NodeNext", "types": ["node"],
    "strict": true, "noUncheckedIndexedAccess": true, "verbatimModuleSyntax": true,
    "declaration": true, "sourceMap": true, "skipLibCheck": true,
    "outDir": "dist", "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
